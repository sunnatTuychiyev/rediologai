{
  "name": "radiologai-talim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:reset": "prisma migrate reset --force",
    "import:real": "tsx prisma/import-real-cases.ts",
    "import:mammo": "tsx scripts/mammo/import.ts",
    "eval:mammo": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/mammo/evaluate.ts",
    "seed:mammo": "tsx prisma/seed-mammo.ts",
    "ml:serve": "${MAMMO_PYTHON:-python3} ml/server.py",
    "ml:eval": "${MAMMO_PYTHON:-python3} ml/evaluate.py",
    "ml:prepare-cmmd": "${MAMMO_PYTHON:-python3} ml/prepare_cmmd.py",
    "import:cmmd": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/mammo/import-cmmd.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.9.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "dicom-parser": "^1.8.21",
    "lucide-react": "0.468.0",
    "next": "14.2.35",
    "next-auth": "4.24.15",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "sonner": "1.7.4",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
