DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high (low = fastest, ~10-20 s per evaluation)
ANTHROPIC_EFFORT=low

# Mammografiya: tasvir tahlili modeli (lokal ML xizmati, npm run ml:serve)
MAMMO_DRAFT_ENGINE=model            # model | claude-vision (eski: Claude tasvirni o'zi ko'radi)
MAMMO_ENGINE_URL=http://127.0.0.1:8765
MAMMO_PYTHON=python3                # torch, timm, opencv-python-headless, pydicom bor Python
MAMMO_INTENSITY=raw                 # raw | stretch (yorqinlikni yoyish)
